<?xml version="1.0" encoding="utf-8" ?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- =============================================================== -->
    <!-- Basic Style Customization (Required)                            -->
    <!-- =============================================================== -->

    <!-- RemoteActivity theme -->
    <style name="Theme.OmniDemo.Common" parent="Theme.Vizbee.Futura">

        <item name="vzb_appIcon">@drawable/app_logo</item>

        <!-- Your app's theme colors -->
        <!--
          1. Primary Color - this is typically the background color used on most of your app screens
          2. Secondary Color - this is the highlight or accent color used on buttons etc. in your app screens
          3. Tertiary Color - this is the text color used in most of your app screens

          Update the colors below to suit your app.
        -->
        <item name="vzb_primaryColor">#121212</item>
        <item name="vzb_secondaryColor">@color/colorAccent</item>
        <item name="vzb_tertiaryColor">@color/textColorPrimary</item>

        <item name="vzb_widgetEnabledBackgroundColor">#400F0F0F</item>

        <!-- Your app's theme fonts -->
        <!--

          fonts in Assets:
          Provide fonts located in your assets folder including any nested directories.
          i.e 'yourFont.<extension>' or 'fonts/yourFont.<extension>.

          fonts in Resources:
          Provide fonts located in your res/font folder by simply specifying the name of the font file
          excluding any extension. i.e. 'yourFont'

          Update the fonts below to suit your app.
         -->
        <item name="vzb_primaryFont">roboto_bold</item>
        <item name="vzb_secondaryFont">roboto_regular</item>

        <!-- =============================================================== -->
        <!-- Advanced Style Customization (Optional)                         -->
        <!-- =============================================================== -->

        <!-- Card background -->
        <!--
          Set this attribute if you prefer an image background for Vizbee screens
        -->
        <!-- <item name="vzb_backgroundLayerStyle">@style/Theme.Vizbee.Custom.BackgroundStyle</item> -->
        <item name="vzb_backgroundLayerStyle">@style/Theme.Vizbee.TBSTemp.Background</item>

        <!-- -->
        <!-- OVERLAY CARD -->
        <!-- -->

        <!--
            Customize the Overlay cards as shown here
            https://gist.github.com/vizbee/7e9613f76a546c8f9ed9087e91bdc7b1#customize-overlay-cards
        -->

        <item name="vzb_luminosityLayerOverlayStyle">@style/Theme.Vizbee.OmniDemo.LuminosityLayerOverlayStyle</item>
        <item name="vzb_overlayDismissStyle">@style/Theme.Vizbee.OmniDemo.OverlayDismissStyle</item>
        <item name="vzb_overlayContentLayout">@style/Theme.Vizbee.OmniDemo.OverlayContentLayout</item>
        <item name="vzb_overlayTitleLabelStyle">@style/Theme.Vizbee.OmniDemo.OverlayTitleLabelStyle</item>
        <item name="vzb_overlaySubtitleLabelStyle">@style/Theme.Vizbee.OmniDemo.OverlaySubtitleLabelStyle</item>
        <item name="vzb_overlayCallToActionButtonStyle">@style/Theme.Vizbee.OmniDemo.OverlayCallToActionButton</item>

        <!-- -->
        <!-- INTERSTITIAL CARD -->
        <!-- -->

        <!--
            Customize the Interstitial cards as shown here
            https://gist.github.com/vizbee/7e9613f76a546c8f9ed9087e91bdc7b1#customize-interstitial-cards
        -->

        <!-- Titles & subtitles -->
        <item name="vzb_textAppearanceTitle1">@style/Theme.Vizbee.OmniDemo.TitleLabelStyle</item>
        <item name="vzb_titledImageViewTitleLabelStyle">@style/Theme.Vizbee.OmniDemo.TitledImageViewTitleLabelStyle</item>
        <item name="vzb_titledImageViewSubtitleLabelStyle">@style/Theme.Vizbee.OmniDemo.TitledImageViewSubtitleLabelStyle</item>

        <!-- Buttons -->
        <item name="vzb_callToActionButtonStyle">@style/Theme.Vizbee.OmniDemo.CallToActionFilled</item>
        <item name="vzb_deviceStatusViewDisconnectButtonStyle">
            @style/Theme.Vizbee.OmniDemo.DeviceStatusViewCallToActionFilled
        </item>

        <!-- -->
        <!-- SPECIFIC CARD ATTRIBUTES -->
        <!-- -->

        <!-- CastIntroduction Card -->
        <item name="vzb_castIntroductionView">@style/Theme.Vizbee.OmniDemo.CastIntroductionView</item>

        <!-- MultiDeviceSmartInstall Card -->
        <item name="vzb_multiDeviceSmartInstallViewStyle">@style/Theme.Vizbee.OmniDemo.MultiDeviceSmartInstallView</item>

        <!-- CastIcon Card -->
        <item name="vzb_smartPlayDeviceSelectionCardDeviceListViewOverlayStyle">
            @style/Theme.Vizbee.OmniDemo.DeviceListView.CastIconCard
        </item>

        <!-- AppInstall Card -->
        <item name="vzb_appInstall_textStyle">@style/Theme.Vizbee.OmniDemo.AppInstallTextStyle</item>
        <item name="vzb_appInstall_subTextStyle">@style/Theme.Vizbee.OmniDemo.AppInstallSubTextStyle</item>
        <item name="vzb_appInstall_refresh_buttonStyle">@style/Theme.Vizbee.OmniDemo.MinorAction</item>

        <!-- Pairing Card -->
        <item name="vzb_pairingScreen_pinNumberStyle">@style/Theme.Vizbee.OmniDemo.PairingPinPadButton</item>
        <item name="vzb_pairingScreen_numPadButtonStyle">@style/Theme.Vizbee.OmniDemo.PairingPinPadButton</item>
        <item name="vzb_pairingScreen_numPadSubmitButtonStyle">@style/Theme.Vizbee.OmniDemo.PairingPinPadSubmitButton</item>
        <item name="vzb_pairingScreen_refresh_buttonStyle">@style/Theme.Vizbee.OmniDemo.MinorAction</item>

        <!-- Player Card -->
        <!--
            Customize the Player card as shown here
            https://gist.github.com/vizbee/7e9613f76a546c8f9ed9087e91bdc7b1#customize-player-card
        -->
        <!-- Player Card -->
