        <item name="vzb_playerControlsViewStyle">@style/Theme.Vizbee.OmniDemo.PlayerControlsView</item>
        <item name="vzb_videoPlayerControlButtonStyle">@style/Theme.Vizbee.OmniDemo.VideoPlayerControlButton</item>
        <item name="vzb_playerControlsViewPlayPauseButtonStyle">@style/Theme.Vizbee.OmniDemo.VideoPlayerPlayPauseButton</item>
        <item name="vzb_seekBarVideoStyle">@style/Theme.Vizbee.OmniDemo.VideoControlSeekBar</item>
        <item name="vzb_videoControlSeekBarLabelStyle">@style/Theme.Vizbee.OmniDemo.VideoControlSeekBarLabel</item>

        <!-- Player Card -->
        <!--
            Customize the Player card as shown here
            https://gist.github.com/vizbee/7e9613f76a546c8f9ed9087e91bdc7b1#customize-player-card
        -->

        <item name="vzb_playerV3LayoutStyle">@style/Theme.Vizbee.TBSTemp.PlayerV3LayoutStyle</item>

        <!-- Widget styles: HeaderPlayerLayout -->
        <item name="vzb_headerPlayerLayoutStyle">@style/Theme.Vizbee.TBSTemp.HeaderPlayerLayout</item>

        <!-- Widget styles: BodyPlayerLayout -->
        <item name="vzb_bodyPlayerLayoutStyle">@style/Theme.Vizbee.TBSTemp.BodyPlayerLayout</item>

        <!-- Widget styles: FooterPlayerLayout -->
        <item name="vzb_footerPlayerLayoutStyle">@style/Theme.Vizbee.TBSTemp.FooterPlayerLayout</item>

        <!--        <item name="vzb_playerControlsStackViewStyle">@style/Theme.Vizbee.TBSTemp.PlayerControlsStackView</item>-->
        <!--        <item name="vzb_videoPlayerControlButtonStyle">@style/Theme.Vizbee.TBSTemp.VideoPlayerControlButton</item>-->
        <!--        <item name="vzb_playerControlsViewPlayPauseButtonStyle">@style/Theme.Vizbee.TBSTemp.VideoPlayerPlayPauseButton</item>-->

        <!-- Video & Audio SeekBars -->
        <item name="vzb_videoControlSeekBarStyle">@style/Theme.Vizbee.TBSTemp.VideoControlSeekBar</item>
        <!--        <item name="vzb_seekBarVideoStyle">@style/Theme.Vizbee.TBSTemp.SeekBarVideo</item>-->
        <item name="vzb_seekBarAudioStyle">@style/Theme.Vizbee.TBSTemp.AudioControlSeekBar</item>

        <!-- -->
        <!-- SPECIFIC VIEW ATTRIBUTES -->
        <!-- -->

        <!-- Used both in App install and Device Status View -->
        <item name="vzb_deviceSelection_vizbeeIconStyle">@style/Theme.Vizbee.OmniDemo.AnimatedVizbeeIcon</item>

        <!-- Device Status view -->
        <item name="vzb_deviceStatusViewStyle">@style/Theme.Vizbee.OmniDemo.DeviceStatusView</item>
        <item name="vzb_deviceStatusViewLabelStyle">@style/Theme.Vizbee.OmniDemo.DeviceStatusViewLabelStyle</item>

