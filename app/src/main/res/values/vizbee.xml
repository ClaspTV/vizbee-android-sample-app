        <item name="vzb_playerCardV4Style">@style/Theme.Vizbee.OmniDemo.PlayerCardV4Style</item>

        <item name="vzb_contentStatusViewStyle">@style/Theme.Vizbee.OmniDemo.PlayerBufferingStyle</item>
