<?xml version="1.0" encoding="utf-8" ?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- =============================================================== -->
    <!-- Basic Style Customization (Required)                            -->
    <!-- =============================================================== -->


    <!-- RemoteActivity theme -->
    <style name="Theme.DemoFlix.Common" parent="Theme.Vizbee.Futura">

        <item name="vzb_appIcon">@drawable/app_logo</item>

        <!-- Your app's theme colors -->
        <!--
          1. Primary Color - this is typically the background color used on most of your app screens
          2. Secondary Color - this is the highlight or accent color used on buttons etc. in your app screens
          3. Tertiary Color - this is the text color used in most of your app screens

          Update the colors below to suit your app.
        -->
        <item name="vzb_primaryColor">#121212</item>
        <item name="vzb_secondaryColor">@color/colorAccent</item>
        <item name="vzb_tertiaryColor">@color/textColorPrimary</item>

        <item name="vzb_widgetEnabledBackgroundColor">#400F0F0F</item>

        <!-- Your app's theme fonts -->
        <!--

          fonts in Assets:
          Provide fonts located in your assets folder including any nested directories.
          i.e 'yourFont.<extension>' or 'fonts/yourFont.<extension>.

          fonts in Resources:
          Provide fonts located in your res/font folder by simply specifying the name of the font file
          excluding any extension. i.e. 'yourFont'

          Update the fonts below to suit your app.
         -->
        <item name="vzb_primaryFont">roboto_bold</item>
        <item name="vzb_secondaryFont">roboto_regular</item>

        <!-- =============================================================== -->
        <!-- Advanced Style Customization (Optional)                         -->
        <!-- =============================================================== -->

        <!-- Card background -->
        <!--
          Set this attribute if you prefer an image background for Vizbee screens
        -->
        <!-- <item name="vzb_backgroundLayerStyle">@style/Theme.Vizbee.Custom.BackgroundStyle</item> -->

        <!-- -->
        <!-- OVERLAY CARD -->
        <!-- -->

        <!--
            Customize the Overlay cards as shown here
            https://gist.github.com/vizbee/7e9613f76a546c8f9ed9087e91bdc7b1#customize-overlay-cards
        -->

        <item name="vzb_luminosityLayerOverlayStyle">@style/Theme.Vizbee.DemoFlix.LuminosityLayerOverlayStyle</item>
        <item name="vzb_overlayDismissStyle">@style/Theme.Vizbee.DemoFlix.OverlayDismissStyle</item>
        <item name="vzb_overlayContentLayout">@style/Theme.Vizbee.DemoFlix.OverlayContentLayout</item>
        <item name="vzb_overlayTitleLabelStyle">@style/Theme.Vizbee.DemoFlix.OverlayTitleLabelStyle</item>
        <item name="vzb_overlaySubtitleLabelStyle">@style/Theme.Vizbee.DemoFlix.OverlaySubtitleLabelStyle</item>
        <item name="vzb_overlayCallToActionButtonStyle">@style/Theme.Vizbee.DemoFlix.OverlayCallToActionButton</item>

        <!-- -->
        <!-- INTERSTITIAL CARD -->
        <!-- -->

        <!--
            Customize the Interstitial cards as shown here
            https://gist.github.com/vizbee/7e9613f76a546c8f9ed9087e91bdc7b1#customize-interstitial-cards
        -->

        <!-- Titles & subtitles -->
        <item name="vzb_textAppearanceTitle1">@style/Theme.Vizbee.DemoFlix.TitleLabelStyle</item>
        <item name="vzb_titledImageViewTitleLabelStyle">@style/Theme.Vizbee.DemoFlix.TitledImageViewTitleLabelStyle</item>

        <!-- Buttons -->
        <item name="vzb_callToActionButtonStyle">@style/Theme.Vizbee.DemoFlix.CallToActionFilled</item>
        <item name="vzb_deviceStatusViewDisconnectButtonStyle">
            @style/Theme.Vizbee.DemoFlix.DeviceStatusViewCallToActionFilled
        </item>

        <!-- -->
        <!-- SPECIFIC CARD ATTRIBUTES -->
        <!-- -->

        <!-- CastIntroduction Card -->
        <item name="vzb_castIntroductionView">@style/Theme.Vizbee.DemoFlix.CastIntroductionView</item>

        <!-- MultiDeviceSmartInstall Card -->
        <item name="vzb_multiDeviceSmartInstallViewStyle">@style/Theme.Vizbee.DemoFlix.MultiDeviceSmartInstallView</item>

        <!-- CastIcon Card -->
        <item name="vzb_smartPlayDeviceSelectionCardDeviceListViewOverlayStyle">
            @style/Theme.Vizbee.DemoFlix.DeviceListView.CastIconCard
        </item>

        <!-- AppInstall Card -->
        <item name="vzb_appInstall_textStyle">@style/Theme.Vizbee.DemoFlix.AppInstallTextStyle</item>
        <item name="vzb_appInstall_subTextStyle">@style/Theme.Vizbee.DemoFlix.AppInstallSubTextStyle</item>
        <item name="vzb_appInstall_refresh_buttonStyle">@style/Theme.Vizbee.DemoFlix.MinorAction</item>

        <!-- Pairing Card -->
        <item name="vzb_pairingScreen_pinNumberStyle">@style/Theme.Vizbee.DemoFlix.PairingPinPadButton</item>
        <item name="vzb_pairingScreen_numPadButtonStyle">@style/Theme.Vizbee.DemoFlix.PairingPinPadButton</item>
        <item name="vzb_pairingScreen_numPadSubmitButtonStyle">@style/Theme.Vizbee.DemoFlix.PairingPinPadSubmitButton</item>
        <item name="vzb_pairingScreen_refresh_buttonStyle">@style/Theme.Vizbee.DemoFlix.MinorAction</item>

        <!-- Player Card -->
        <!--
            Customize the Player card as shown here
            https://gist.github.com/vizbee/7e9613f76a546c8f9ed9087e91bdc7b1#customize-player-card
        -->
        <!-- Player Card -->
        <item name="vzb_contentStatusViewStyle">@style/Theme.Vizbee.TPlay.PlayerBufferingStyle</item>
        <item name="vzb_adStatusViewStyle">@style/Theme.Vizbee.TPlay.AdStatusView</item>
        <item name="vzb_playerControlsViewStyle">@style/Theme.Vizbee.TPlay.PlayerControlsView</item>
        <item name="vzb_videoPlayerControlButtonStyle">@style/Theme.Vizbee.TPlay.VideoPlayerControlButton</item>
        <item name="vzb_playerControlsViewPlayPauseButtonStyle">@style/Theme.Vizbee.TPlay.VideoPlayerPlayPauseButton</item>
        <item name="vzb_seekBarVideoStyle">@style/Theme.Vizbee.TPlay.VideoControlSeekBar</item>
        <item name="vzb_videoControlSeekBarLabelStyle">@style/Theme.Vizbee.TPlay.VideoControlSeekBarLabel</item>

        <!-- -->
        <!-- SPECIFIC VIEW ATTRIBUTES -->
        <!-- -->

        <!-- Used both in App install and Device Status View -->
        <item name="vzb_deviceSelection_vizbeeIconStyle">@style/Theme.Vizbee.DemoFlix.AnimatedVizbeeIcon</item>

        <!-- Device Status view -->
        <item name="vzb_deviceStatusViewStyle">@style/Theme.Vizbee.DemoFlix.DeviceStatusView</item>
        <item name="vzb_deviceStatusViewLabelStyle">@style/Theme.Vizbee.DemoFlix.DeviceStatusViewLabelStyle</item>

        <!-- Device Info view -->
        <item name="vzb_deviceInfoViewIconStyle">@style/Theme.Vizbee.DemoFlix.DeviceInfoViewIconStyle</item>
        <item name="vzb_deviceInfoViewNameLabelStyle">@style/Theme.Vizbee.DemoFlix.DeviceInfoViewLabelStyle</item>
    </style>

    <style name="Theme.Vizbee.DemoFlix.LuminosityLayerOverlayStyle" parent="Widget.Vizbee.Futura.LuminosityLayer.Overlay">
        <item name="android:alpha">0</item>
    </style>

    <style name="Theme.Vizbee.DemoFlix.OverlayContentLayout" parent="Widget.Vizbee.OverlayContentLayout">
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">48dp</item>
        <item name="android:paddingLeft">20dp</item>
        <item name="android:paddingRight">20dp</item>
    </style>

    <style name="Theme.Vizbee.DemoFlix.OverlayDismissStyle" parent="Widget.Vizbee.Image.OverlayDismiss">
        <item name="android:paddingTop">16dp</item>
        <item name="android:paddingLeft">16dp</item>
        <item name="android:paddingRight">16dp</item>
    </style>

    <style name="Theme.Vizbee.DemoFlix.OverlayTitleLabelStyle" parent="Widget.Vizbee.OverlayTitleLabel">
        <item name="android:textAllCaps">false</item>
        <item name="vzb_deviceListTitleTextAppearance" tools:ignore="PrivateResource">?attr/vzb_textAppearanceTitle2
        </item>
        <item name="android:textSize">20sp</item>
        <item name="android:paddingBottom">4dp</item>
    </style>

    <style name="Theme.Vizbee.DemoFlix.OverlaySubtitleLabelStyle" parent="Widget.Vizbee.OverlaySubtitleLabel">
        <item name="android:textAppearance" tools:ignore="PrivateResource">?attr/vzb_textAppearanceBody</item>
        <item name="android:textColor">#C6CBD7</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="Theme.Vizbee.DemoFlix.OverlayCallToActionButton" parent="@style/Widget.Vizbee.Futura.Button.OverlayCallToAction">
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">roboto_regular</item>
        <item name="android:textColor">@color/textColorPrimary</item>
        <item name="android:textAppearance" tools:ignore="PrivateResource">?attr/vzb_textAppearanceBody</item>
        <item name="vzb_cornerRadius">6dp</item>
        <item name="android:paddingTop">15dp</item>
        <item name="android:paddingBottom">15dp</item>
        <item name="vzb_backgroundEnabled">?attr/vzb_secondaryColor</item>
    </style>

    <!-- title label style-->
    <style name="Theme.Vizbee.DemoFlix.TitleLabelStyle" parent="TextAppearance.Vizbee.Title1">
        <item name="vzb_deviceListTitleTextAppearance" tools:ignore="PrivateResource">?attr/vzb_textAppearanceTitle2
        </item>
        <item name="android:textSize">20sp</item>
    </style>

    <style name="Theme.Vizbee.DemoFlix.TitledImageViewTitleLabelStyle" parent="Widget.Vizbee.Futura.TitledImageViewTitleLabel">
        <item name="android:paddingTop">28dp</item>
        <item name="vzb_deviceListTitleTextAppearance" tools:ignore="PrivateResource">?attr/vzb_textAppearanceTitle2
        </item>
        <item name="android:textSize">20sp</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="Theme.Vizbee.DemoFlix.DeviceListViewTitleLabel" parent="Widget.Vizbee.Futura.DeviceListViewTitleLabel">
        <item name="android:textSize">20sp</item>
    </style>

    <!-- CTA -->
    <style name="Theme.Vizbee.DemoFlix.CallToActionFilled" parent="Widget.Vizbee.Futura.Button.CallToAction">
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">roboto_regular</item>
        <item name="android:textColor">@color/textColorPrimary</item>
        <item name="android:textAppearance" tools:ignore="PrivateResource">?attr/vzb_textAppearanceBody</item>
        <item name="vzb_cornerRadius">6dp</item>
        <item name="android:paddingTop">15dp</item>
        <item name="android:paddingBottom">15dp</item>
        <item name="vzb_backgroundEnabled">?attr/vzb_secondaryColor</item>
    </style>

    <style name="Theme.Vizbee.DemoFlix.DeviceStatusViewCallToActionFilled" parent="Theme.Vizbee.DemoFlix.CallToActionFilled">
        <item name="android:layout_marginTop">28dp</item>
    </style>

    <!-- CastIntroductionView -->
    <style name="Theme.Vizbee.DemoFlix.CastIntroductionView" parent="Widget.Vizbee.Futura.SpacedLinearLayout.CastIntroductionView">
        <item name="vzb_deviceListViewStyle">@style/Theme.Vizbee.DemoFlix.DeviceListView</item>
    </style>

    <!-- MultiDeviceSmartInstallView -->
    <style name="Theme.Vizbee.DemoFlix.MultiDeviceSmartInstallView" parent="Widget.Vizbee.Futura.SpacedLinearLayout.MultiDeviceSmartInstallView">
        <item name="vzb_deviceListViewStyle">@style/Theme.Vizbee.DemoFlix.DeviceListView</item>
        <item name="vzb_headerStackViewStyle">@style/Theme.Vizbee.DemoFlix.MultiDeviceSmartInstallView.HeaderStackView</item>
    </style>

    <style name="Theme.Vizbee.DemoFlix.MultiDeviceSmartInstallView.HeaderStackView" parent="Widget.Vizbee.Futura.Light.SpacedLinearLayout.MultiDeviceSmartInstallView.HeaderStackView">
        <item name="vzb_overlaySubtitleLabelStyle">@style/Theme.Vizbee.DemoFlix.OverlaySubtitleLabelStyle</item>
    </style>

    <!-- DeviceListView -->
    <style name="Theme.Vizbee.DemoFlix.DeviceListView" parent="Widget.Vizbee.Futura.DeviceListView">
        <item name="vzb_deviceListCornerRadius">3dp</item>
        <item name="vzb_showDeviceDivider">true</item>
        <item name="vzb_deviceListDividerColor">#333333</item>
        <item name="vzb_deviceListHeaderPadding">0dp</item>
        <item name="vzb_deviceListRowStyle">@style/Theme.Vizbee.DemoFlix.DeviceListRowStyle</item>
    </style>

    <style name="Theme.Vizbee.DemoFlix.DeviceListRowStyle" parent="Widget.Vizbee.Futura.DeviceListItemView">
        <item name="vzb_backgroundEnabled">#1a1a1a</item>
        <item name="vzb_backgroundDisabled">#1a1a1a</item>
        <item name="vzb_backgroundSelected">#1a1a1a</item>
    </style>

    <style name="Theme.Vizbee.DemoFlix.DeviceListView.CastIconCard" parent="Widget.Vizbee.Futura.DeviceListView.SmartPlayCard.Overlay">
        <item name="vzb_deviceListTitleTextAppearance">@style/Theme.Vizbee.DemoFlix.OverlayTitleLabelStyle</item>
        <item name="vzb_enableListHeaderDivider">false</item>
        <item name="vzb_deviceListHeaderPadding">12dp</item>
    </style>

    <!-- DeviceStatusView -->
    <style name="Theme.Vizbee.DemoFlix.DeviceStatusView" parent="Widget.Vizbee.Futura.DeviceStatusView">
        <item name="vzb_statusProgressStyle">android_native</item>
    </style>

    <style name="Theme.Vizbee.DemoFlix.DeviceStatusViewLabelStyle" parent="Widget.Vizbee.Futura.TitledImageViewTitleLabel">
        <item name="android:textAllCaps">false</item>
        <item name="vzb_deviceListTitleTextAppearance" tools:ignore="PrivateResource">?attr/vzb_textAppearanceTitle2
        </item>
        <item name="android:textSize">20sp</item>
    </style>

    <!-- DeviceInfoView -->
    <style name="Theme.Vizbee.DemoFlix.DeviceInfoViewLabelStyle" parent="Widget.Vizbee.Futura.DeviceInfoViewNameLabel">
        <item name="android:textAllCaps">false</item>
        <item name="vzb_deviceListTitleTextAppearance" tools:ignore="PrivateResource">?attr/vzb_textAppearanceTitle2
        </item>
        <item name="android:textSize">16sp</item>
        <item name="vzb_typeface">roboto_medium</item>
<!--        <item name="android:paddingTop">19dp</item>-->
<!--        <item name="android:paddingBottom">19dp</item>-->
    </style>

    <style name="Theme.Vizbee.DemoFlix.DeviceInfoViewIconStyle" parent="Widget.Vizbee.Futura.DeviceInfoViewIcon">
        <item name="android:layout_marginRight">6dp</item>
    </style>

    <!-- Player Card -->
    <style name="Theme.Vizbee.TPlay.PlayerBufferingStyle" parent="Widget.Vizbee.Futura.ContentStatusView">
        <item name="android:background">#B3FFFFFF</item>
    </style>

    <style name="Theme.Vizbee.TPlay.AdStatusView" parent="Widget.Vizbee.Futura.AdStatusView">
        <item name="android:background">#B3FFFFFF</item>
    </style>

    <style name="Theme.Vizbee.TPlay.PlayerControlsView" parent="Widget.Vizbee.Futura.PlayerControlsView">
<!--        <item name="vzb_playButtonDrawable">@drawable/tplay_ic_play_button</item>-->
<!--        <item name="vzb_pauseButtonDrawable">@drawable/tplay_ic_pause_button</item>-->
<!--        <item name="vzb_stopButtonDrawable">@drawable/tplay_ic_stop_button</item>-->
<!--        <item name="vzb_rewindButtonDrawable">@drawable/tplay_ic_rewind_30s_button</item>-->
    </style>

    <style name="Theme.Vizbee.TPlay.VideoPlayerControlButton" parent="Widget.Vizbee.Futura.Button.VideoPlayerControl">
        <item name="android:layout_height">60dp</item>
        <item name="android:layout_width">60dp</item>
        <item name="android:layout_marginLeft">10dp</item>
        <item name="android:layout_marginRight">10dp</item>
        <item name="vzb_checkedSrcColor">?attr/vzb_secondaryColor</item>
        <item name="vzb_backgroundEnabled">?attr/vzb_secondaryColor</item>
        <item name="vzb_srcColor">?attr/vzb_tertiaryColor</item>
    </style>

    <style name="Theme.Vizbee.TPlay.VideoPlayerPlayPauseButton" parent="Widget.Vizbee.Futura.Button.VideoPlayerControl.PlayPause">
        <item name="android:layout_height">84dp</item>
        <item name="android:layout_width">84dp</item>
        <item name="android:layout_marginLeft">10dp</item>
        <item name="android:layout_marginRight">10dp</item>
        <item name="android:padding">16dp</item>
        <item name="vzb_backgroundEnabled">?attr/vzb_secondaryColor</item>
        <item name="vzb_srcColor">?attr/vzb_tertiaryColor</item>
    </style>

    <style name="Theme.Vizbee.TPlay.VideoControlSeekBar" parent="Widget.Vizbee.Futura.VideoControlSeekBar">
        <item name="vzb_useCircularThumb">true</item>
    </style>

    <style name="Theme.Vizbee.TPlay.VideoControlSeekBarLabel" parent="Widget.Vizbee.Futura.VideoControlSeekBarLabel">
        <item name="android:textAppearance">?attr/vzb_textAppearanceBody</item>
        <item name="android:textColor">#B1B1B1</item>
    </style>

    <!-- AnimatedVizbeeIcon -->
    <style name="Theme.Vizbee.DemoFlix.AnimatedVizbeeIcon" parent="Widget.Vizbee.Futura.AnimatedVizbeeIcon">
        <item name="android:layout_marginTop">0dp</item>
    </style>

    <!-- AppInstall -->
    <style name="Theme.Vizbee.DemoFlix.AppInstallTextStyle" parent="VZB_AppInstallTextStyle">
        <item name="android:textSize">16sp</item>
    </style>

    <style name="Theme.Vizbee.DemoFlix.AppInstallSubTextStyle" parent="VZB_AppInstallSubTextStyle">
        <item name="android:textSize">14sp</item>
    </style>

    <style name="Theme.Vizbee.DemoFlix.MinorAction" parent="Widget.Vizbee.Futura.Button.MinorAction">
        <item name="android:textSize">14sp</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:orientation">vertical</item>
    </style>

    <!-- Pairing -->
    <style name="Theme.Vizbee.DemoFlix.PairingPinPadButton" parent="Widget.Vizbee.Futura.Button.PinPad">
        <item name="android:textSize">14sp</item>
    </style>

    <style name="Theme.Vizbee.DemoFlix.PairingPinPadSubmitButton" parent="Widget.Vizbee.Futura.Button.PinPad.Submit">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">?attr/vzb_secondaryColor</item>
    </style>

    <string name="casting_to">Casting to %1$s</string>
</resources>
