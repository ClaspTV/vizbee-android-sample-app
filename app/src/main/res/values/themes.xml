<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.VizbeeDemo" parent="Theme.AppCompat.DayNight.DarkActionBar">
        <!-- Customize your dark theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimary</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <!-- Splash Screen Theme -->
    <style name="Base.Theme.VizbeeDemo.SplashScreen" >
        <item name="android:windowBackground">@drawable/splash_screen</item>

        <!-- Splash screen icon animation duration (optional) -->
        <item name="windowSplashScreenAnimationDuration">5000</item>
    </style>

    <!--  region SmartHandoff  -->
    <!-- Smart Handoff Card Styles -->
    <style name="SmartHandoff" />

    <style name="SmartHandoff.Card">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/handoff_card_height</item>
        <item name="android:layout_marginBottom">@dimen/handoff_card_margin</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:foreground">?android:attr/selectableItemBackground</item>
        <item name="cardCornerRadius">@dimen/handoff_card_corner_radius</item>
        <item name="cardElevation">@dimen/handoff_card_elevation</item>
    </style>

    <!-- Background Image Style -->
    <style name="SmartHandoff.BackgroundImage">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:scaleType">centerCrop</item>
        <item name="android:contentDescription">@string/handoff_background_image_desc</item>
    </style>

    <!-- Content Container Style -->
    <style name="SmartHandoff.ContentContainer">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:gravity">bottom</item>
        <item name="android:background">@drawable/handoff_bg</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:padding">@dimen/handoff_content_padding</item>
    </style>

    <!-- Text Container Style -->
    <style name="SmartHandoff.TextContainer">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:orientation">vertical</item>
    </style>

    <!-- Title Text Style -->
    <style name="SmartHandoff.Title">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:ellipsize">end</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:maxLines">1</item>
        <item name="android:textColor">@color/handoff_text_primary</item>
        <item name="android:textSize">@dimen/handoff_title_text_size</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Subtitle Text Style -->
    <style name="SmartHandoff.Subtitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">@dimen/handoff_subtitle_margin_top</item>
        <item name="android:ellipsize">end</item>
        <item name="android:lineSpacingExtra">2dp</item>
        <item name="android:maxLines">2</item>
        <item name="android:textColor">@color/handoff_text_secondary</item>
        <item name="android:textSize">@dimen/handoff_subtitle_text_size</item>
    </style>

    <!-- Watch Now Button Style -->
    <style name="SmartHandoff.WatchNowButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_gravity">bottom</item>
        <item name="android:background">@drawable/watch_now_button_bg</item>
        <item name="android:paddingStart">@dimen/handoff_button_padding_horizontal</item>
        <item name="android:paddingEnd">@dimen/handoff_button_padding_horizontal</item>
        <item name="android:paddingTop">@dimen/handoff_button_padding_vertical</item>
        <item name="android:paddingBottom">@dimen/handoff_button_padding_vertical</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:text">@string/watch_now</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/handoff_button_text</item>
        <item name="android:textSize">@dimen/handoff_button_text_size</item>
    </style>
    <!--  endregion  -->
</resources>